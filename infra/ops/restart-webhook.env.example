# Copy to: ~/.openclaw/infra/ops/restart-webhook.env
# Then fill values and chmod 600 on the file.

# Required
export TELEGRAM_OPS_BOT_TOKEN="123456789:replace-me"
export TELEGRAM_WEBHOOK_SECRET="replace-with-long-random-secret"

# Required allowlists (comma-separated, no spaces)
# Example group chat id: -1003705080681
export TELEGRAM_ALLOWED_CHAT_IDS="-1003705080681"
# Example user id: 801195564
export TELEGRAM_ALLOWED_USER_IDS="801195564"

# Webhook listener binding
export TELEGRAM_RESTART_WEBHOOK_HOST="127.0.0.1"
export TELEGRAM_RESTART_WEBHOOK_PORT="8787"
export TELEGRAM_WEBHOOK_PATH="/telegram/restart-webhook"

# Optional script override (default is ~/.openclaw/infra/restart-secure.sh)
# export OPENCLAW_RESTART_SCRIPT="$HOME/.openclaw/infra/restart-secure.sh"

# Optional default args appended on every restart
# export OPENCLAW_RESTART_EXTRA_ARGS="--net"

# Optional explicit OPENCLAW_HOME
export OPENCLAW_HOME="$HOME/.openclaw"
